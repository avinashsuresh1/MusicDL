{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MusicDL",
  "version": "1.1.7",
  "identifier": "app.musicdl",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/clean-bundle.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MusicDL Editor",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "msi", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["libasound2"]
      },
      "rpm": {
        "depends": ["alsa-lib"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
